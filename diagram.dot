digraph OrderService {
    rankdir=TB;
    splines=true;
    nodesep=1.0;
    ranksep=0.8;
    pad=0.3;

    node [
        shape=box,
        style=rounded,
        fontname="Arial",
        fontsize=12,
        width=2.6,
        height=0.5
    ];
    edge [arrowsize=0.8];

    main [label="order-service-main"];
    persistence [label="order-service-persistence"];
    restapi [label="order-service-restapi"];
    messaging [label="order-service-messaging"];
    app [label="order-application-service"];
    core [label="order-domain-core"];
    common [label="common-domain"];

    { rank=same; persistence; restapi; messaging; }

    main -> persistence;
    main -> restapi;
    main -> messaging;
    main:w -> app:w;
    main:w -> core:w;

    persistence -> app;
    restapi -> app;
    messaging -> app;

    app -> core;
    core -> common;
}
